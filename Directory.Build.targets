<Project>

  <!-- Imported after the project body, so IsPackable/IsTestProject are settled. -->

  <!-- Every package ships the README. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
