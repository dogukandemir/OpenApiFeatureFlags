<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The repository multi-targets libraries; a sample only needs the newest runtime. -->
    <TargetFrameworks />
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>OpenApiFeatureFlags.AspNetCore.Sample</RootNamespace>
    <Description>The same gated API as the other samples, with its document generated by the built-in engine.</Description>
    <!-- Sample code favours readability over shipping-oriented analyzer rules. -->
    <NoWarn>$(NoWarn);CA1822;CA1062</NoWarn>
    <!-- The engine's XML-comment support emits interceptors, and the compiler refuses them unless
         their namespace is opted into. A project with XML doc comments needs this line; see
         docs/aspnetcore.md. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenApiFeatureFlags.AspNetCore\OpenApiFeatureFlags.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\OpenApiFeatureFlags.FeatureManagement\OpenApiFeatureFlags.FeatureManagement.csproj" />
  </ItemGroup>

</Project>
