<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The repository multi-targets libraries; a sample only needs the newest runtime. -->
    <TargetFrameworks />
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>OpenApiFeatureFlags.FastEndpoints.Sample</RootNamespace>
    <Description>The same gated API as the other samples, built with FastEndpoints and documented through the built-in engine.</Description>
    <!-- Sample code favours readability over shipping-oriented analyzer rules. -->
    <NoWarn>$(NoWarn);CA1822;CA1062;CA1515</NoWarn>
    <!-- FastEndpoints generates its document through the built-in engine, whose XML-comment support
         emits interceptors; the compiler refuses them unless their namespace is opted into. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" />
    <PackageReference Include="FastEndpoints.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenApiFeatureFlags.AspNetCore\OpenApiFeatureFlags.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\OpenApiFeatureFlags.FeatureManagement\OpenApiFeatureFlags.FeatureManagement.csproj" />
  </ItemGroup>

</Project>
