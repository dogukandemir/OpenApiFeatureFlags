<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The repository multi-targets libraries; a sample only needs the newest runtime. -->
    <TargetFrameworks />
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>OpenApiFeatureFlags.Sample</RootNamespace>
    <Description>A minimal API whose OpenAPI document respects feature flags.</Description>
    <!-- Sample code favours readability over shipping-oriented analyzer rules. -->
    <NoWarn>$(NoWarn);CA1822;CA1062</NoWarn>
    <!-- Emit the document at build time as well as serving it, so the sample doubles as a check of
         the offline (no HttpContext) path. Swashbuckle's props default this to false. -->
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\openapi</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenApiFeatureFlags.Swashbuckle\OpenApiFeatureFlags.Swashbuckle.csproj" />
    <ProjectReference Include="..\..\src\OpenApiFeatureFlags.FeatureManagement\OpenApiFeatureFlags.FeatureManagement.csproj" />
  </ItemGroup>

</Project>
