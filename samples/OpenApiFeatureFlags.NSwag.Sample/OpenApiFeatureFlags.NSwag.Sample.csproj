<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The repository multi-targets libraries; a sample only needs the newest runtime. -->
    <TargetFrameworks />
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>OpenApiFeatureFlags.NSwag.Sample</RootNamespace>
    <Description>The same gated API as the other samples, with its document generated by NSwag.</Description>
    <!-- Sample code favours readability over shipping-oriented analyzer rules. -->
    <NoWarn>$(NoWarn);CA1822;CA1062</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSwag.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenApiFeatureFlags.NSwag\OpenApiFeatureFlags.NSwag.csproj" />
    <ProjectReference Include="..\..\src\OpenApiFeatureFlags.FeatureManagement\OpenApiFeatureFlags.FeatureManagement.csproj" />
  </ItemGroup>

</Project>
