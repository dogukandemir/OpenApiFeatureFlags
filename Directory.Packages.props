<Project>

  <!-- =====================================================================
       Central package versions. Every version is pinned here; project files
       carry PackageReference without a Version attribute.
       Versions verified against nuget.org on 2026-10-11.
       ===================================================================== -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Document engines">
    <!-- Swashbuckle 10.3.0 ships net8.0/net9.0/net10.0 (verified 2026-10-11). -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.0" />
    <!-- The Swashbuckle adapter references this package directly, so this pin is what
         OpenApiFeatureFlags.Swashbuckle publishes as its dependency floor. 2.7.5 is a deliberately low
         floor, not a match for Swashbuckle's own: its nuspec declares the version unbracketed, which
         NuGet reads as "or later", so any 2.x above this would do as well. Raising the pin narrows what
         consumers may resolve, so it needs a reason.
         Microsoft.OpenApi 3.x is a different, binary-incompatible line: using it produces
         MissingMethodException at document generation time, not a compile error. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- Only a package some project actually references is pinned here. Swashbuckle.AspNetCore.Swagger
         and .SwaggerUI arrive transitively through the metapackage. NSwag is pinned below because an
         adapter now builds against it. A pin for a package no project builds only asks Dependabot to
         raise pull requests for it. -->
    <!-- The built-in ASP.NET Core document engine, used by OpenApiFeatureFlags.AspNetCore, which is net10.0
         only. That project references this WITHOUT a Microsoft.OpenApi pin on purpose: the engine
         brings its own [2.12.0, 3.0.0) floor, which the 2.7.5 above would violate. Transitive pinning
         is off, so the two engines resolve independently inside one solution. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- NSwag 14.7.1 ships net8.0/net9.0/net10.0 on the NJsonSchema 11.x line (verified 2026-10-11).
         The adapter references the generation package only; the full NSwag.AspNetCore is referenced
         by the test project alone, because the only way to obtain a document the way a consumer does
         is to ask the middleware that serves it. The processor model this adapter is built on was
         measured against these assemblies, not taken from documentation; see docs/design.md. -->
    <PackageVersion Include="NSwag.Generation.AspNetCore" Version="14.7.1" />
    <PackageVersion Include="NSwag.AspNetCore" Version="14.7.1" />
    <!-- Used only by the FastEndpoints test project: since v8.2 the framework generates its document
         through Microsoft.AspNetCore.OpenApi, so the adapter under test there is the AspNetCore one
         (docs/fastendpoints.md). -->
    <PackageVersion Include="FastEndpoints" Version="8.3.0" />
    <PackageVersion Include="FastEndpoints.OpenApi" Version="8.3.0" />
  </ItemGroup>

  <ItemGroup Label="Flag sources">
    <!-- Plain Microsoft.FeatureManagement, not the .AspNetCore flavour: the adapter only needs
         IFeatureManager, and the ASP.NET version would drag MVC in for nothing. -->
    <PackageVersion Include="Microsoft.FeatureManagement" Version="4.8.0" />
    <!-- Azure App Configuration is not referenced by the library: it is reached through
         IFeatureManager, so there is no Azure-specific code to ship. See docs/azure-app-configuration.md. -->
    <!-- OpenFeature is the CNCF vendor-neutral standard. -->
    <PackageVersion Include="OpenFeature" Version="2.14.1" />
  </ItemGroup>

  <ItemGroup Label="Build">
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <!-- Built against the oldest Roslyn the family's net8.0 floor ships. An analyzer package must
         not be built against the newest line: consumers on older SDKs would see CS9057, which
         their build may treat as an error. This pin is a compatibility floor, not an update
         target; the analyzer code uses no API newer than this line. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- A real in-memory host. Unlike Swashbuckle, the ASP.NET Core engine exposes no public document
         provider, so the only way to obtain a generated document is to ask the endpoint that serves
         it, which also means the transformers are tested in the position they really run in. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <!-- Test projects run on xunit.v3 + Microsoft.Testing.Platform, which the
         .NET 10 SDK requires: VSTest is no longer supported for MTP projects, so
         Microsoft.NET.Test.Sdk is deliberately absent. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- Shouldly, not FluentAssertions: v8 of the latter is no longer free for
         commercial use, and this library is MIT. -->
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

</Project>
