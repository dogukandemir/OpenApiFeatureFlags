<Project>

  <!-- =====================================================================
       Common build settings for every project in the repository.
       The licence, the supported frameworks and the tracked public API are enforced here.
       ===================================================================== -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet audit: a known vulnerability anywhere in the dependency graph (direct or
         transitive) is a warning, and warnings are errors here, so a vulnerable graph fails
         the build rather than travelling onwards. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML comment) is not worth failing a build over, but the
         documented surface is still emitted so IntelliSense consumers get it. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The repository targets three frameworks so consumers on .NET 8 are served. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <!-- Only .NET 10 runtimes are assumed on developer machines; tests still
         execute the net8.0/net9.0 binaries through roll-forward. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <!-- Package metadata. -->
  <PropertyGroup>
    <!-- Pre-1.0 while the Swashbuckle integration settles; see Q1 in docs/design.md. Bumping this is
         also what keeps a local re-pack from colliding with NuGet's version cache. -->
    <VersionPrefix>0.2.3</VersionPrefix>
    <!-- Authors is what nuget.org renders as "Authors". nuget.org's separate *Owners* list is
         derived from the account that pushed the package plus the reserved prefix, and cannot be
         set from here; PackageOwners is ignored by nuget.org, so it is deliberately absent. -->
    <Authors>Dogukan Demir</Authors>
    <Company>Dogukan Demir</Company>
    <Copyright>Copyright (c) 2026 Dogukan Demir</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dogukandemir/OpenApiFeatureFlags</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dogukandemir/OpenApiFeatureFlags</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageTags>openapi;swagger;openapi-document;feature-flags;feature-management;swashbuckle;openfeature;aspnetcore;hide;exclude;conditional</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The package icon: the 'double toggle' mark in Solarized cyan. The source of truth is
         assets/icon.svg; assets/icon-128.png is what packs (nuget.org's recommended size). -->
    <PackageIcon>icon-128.png</PackageIcon>
  </PropertyGroup>

  <!-- The public surface is a permanent contract, so it is tracked explicitly. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
