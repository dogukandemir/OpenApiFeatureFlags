<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>OpenApiFeatureFlags.OpenFeature</PackageId>
    <AssemblyName>OpenApiFeatureFlags.OpenFeature</AssemblyName>
    <RootNamespace>OpenApiFeatureFlags.OpenFeature</RootNamespace>
    <Title>OpenApiFeatureFlags.OpenFeature</Title>
    <Description>OpenFeature flag source for OpenApiFeatureFlags: reads flags through the CNCF vendor-neutral standard instead of a vendor SDK.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- D8, the flag axis. OpenFeature is the vendor-neutral standard: interoperate with it, do not
         name after it. -->
    <PackageReference Include="OpenFeature" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenApiFeatureFlags\OpenApiFeatureFlags.csproj" />
    <ProjectReference Include="..\OpenApiFeatureFlags.Abstractions\OpenApiFeatureFlags.Abstractions.csproj" />
  </ItemGroup>

</Project>
