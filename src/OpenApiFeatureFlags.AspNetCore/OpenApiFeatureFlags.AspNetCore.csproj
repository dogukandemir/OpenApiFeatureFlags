<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>OpenApiFeatureFlags.AspNetCore</PackageId>
    <AssemblyName>OpenApiFeatureFlags.AspNetCore</AssemblyName>
    <RootNamespace>OpenApiFeatureFlags.AspNetCore</RootNamespace>
    <Title>OpenApiFeatureFlags.AspNetCore</Title>
    <Description>Adapter for OpenApiFeatureFlags for the built-in Microsoft.AspNetCore.OpenApi document engine: hides gated operations, parameters and schema properties from the generated document.</Description>
    <!-- net10.0 only, and that is a documented cost rather than an oversight: the engine's 8.x and 9.x
         lines sit on the Microsoft.OpenApi 1.x document model, which is a different set of types, so
         multi-targeting would mean three implementations rather than one source file. See
         docs/design.md 4.4. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The engine brings Microsoft.OpenApi transitively at the version the engine itself was built
         against. It is deliberately NOT referenced directly: an explicit reference would take the
         centrally pinned 2.7.5, which this engine's [2.12.0, 3.0.0) floor rejects. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenApiFeatureFlags\OpenApiFeatureFlags.csproj" />
    <ProjectReference Include="..\OpenApiFeatureFlags.Abstractions\OpenApiFeatureFlags.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenApiFeatureFlags.AspNetCore.Tests" />
  </ItemGroup>

</Project>
