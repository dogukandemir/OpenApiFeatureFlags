<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>OpenApiFeatureFlags</PackageId>
    <AssemblyName>OpenApiFeatureFlags</AssemblyName>
    <RootNamespace>OpenApiFeatureFlags</RootNamespace>
    <Title>OpenApiFeatureFlags</Title>
    <Description>Hide feature-flagged endpoints, parameters and schema properties from Swagger/OpenAPI documents in .NET, using the flags the app already reads. This core package builds the engine-agnostic plan. Install one adapter next: OpenApiFeatureFlags.Swashbuckle, OpenApiFeatureFlags.AspNetCore or OpenApiFeatureFlags.NSwag.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The core needs HttpContext (per-request flag memoization, 4.1), ILogger and
         IServiceCollection. It deliberately does NOT reference a document engine (D9),
         which is why Swashbuckle/NSwag appear only in the adapter packages. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenApiFeatureFlags.Abstractions\OpenApiFeatureFlags.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DescriptionGateResolver is internal here and shared by every document-engine adapter, so the
         gates have one implementation and cannot drift apart on quoting, nesting or unbalanced tags.
         Its direct unit tests stay with the Swashbuckle suite, next to the humanizer measurement they
         depend on. -->
    <InternalsVisibleTo Include="OpenApiFeatureFlags.Swashbuckle" />
    <InternalsVisibleTo Include="OpenApiFeatureFlags.Swashbuckle.Tests" />
    <InternalsVisibleTo Include="OpenApiFeatureFlags.AspNetCore" />
    <InternalsVisibleTo Include="OpenApiFeatureFlags.AspNetCore.Tests" />
    <InternalsVisibleTo Include="OpenApiFeatureFlags.NSwag" />
    <InternalsVisibleTo Include="OpenApiFeatureFlags.NSwag.Tests" />
  </ItemGroup>

</Project>
