<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>OpenApiFeatureFlags.Swashbuckle</PackageId>
    <AssemblyName>OpenApiFeatureFlags.Swashbuckle</AssemblyName>
    <RootNamespace>OpenApiFeatureFlags.Swashbuckle</RootNamespace>
    <Title>OpenApiFeatureFlags.Swashbuckle</Title>
    <Description>Swashbuckle adapter for OpenApiFeatureFlags. Install this package if the API documents through Swashbuckle.AspNetCore: a gated endpoint, parameter or schema property is left out of the generated Swagger/OpenAPI document while its flag is off, and appears again when the flag turns on.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the generator: the meta-package would drag in SwaggerUI and ReDoc. -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" />
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenApiFeatureFlags\OpenApiFeatureFlags.csproj" />
    <ProjectReference Include="..\OpenApiFeatureFlags.Abstractions\OpenApiFeatureFlags.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The <gate> parser has enough edge cases (nesting, self-closing, unbalanced, quoting) that it
         deserves direct unit tests rather than only indirect ones through a document. -->
    <InternalsVisibleTo Include="OpenApiFeatureFlags.Swashbuckle.Tests" />
  </ItemGroup>

</Project>
