<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>OpenApiFeatureFlags.Swashbuckle</PackageId>
    <AssemblyName>OpenApiFeatureFlags.Swashbuckle</AssemblyName>
    <RootNamespace>OpenApiFeatureFlags.Swashbuckle</RootNamespace>
    <Title>OpenApiFeatureFlags.Swashbuckle</Title>
    <Description>Swashbuckle adapter for OpenApiFeatureFlags: hides gated operations, parameters and schema properties from the generated OpenAPI document.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the generator: the meta-package would drag in SwaggerUI and ReDoc. -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" />
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenApiFeatureFlags\OpenApiFeatureFlags.csproj" />
    <ProjectReference Include="..\OpenApiFeatureFlags.Abstractions\OpenApiFeatureFlags.Abstractions.csproj" />
  </ItemGroup>

</Project>
