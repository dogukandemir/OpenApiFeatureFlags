<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>OpenApiFeatureFlags.Tests</RootNamespace>
    <!-- xunit.v3 test projects are executables and run on Microsoft.Testing.Platform. -->
    <OutputType>Exe</OutputType>
    <!-- The MTP opt-in lives in global.json / the DOTNET_TEST_RUNNER variable, not here. -->
    <!-- Test code is not shipped, so the shipping-oriented CA rules are noise here.
         xunit's own analyzers stay enabled, and the rules below stay disabled
         explicitly rather than lowering the whole analysis level. -->
    <NoWarn>$(NoWarn);CA1031;CA1034;CA1052;CA1062;CA1303;CA1305;CA1515;CA1707;CA1812;CA1819;CA1822;CA1859;CA1860;CA1861;CA2007;CA2201;CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.NET.Test.Sdk is deliberately absent: it would drag VSTest back in. -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenApiFeatureFlags.Abstractions\OpenApiFeatureFlags.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\OpenApiFeatureFlags\OpenApiFeatureFlags.csproj" />
  </ItemGroup>

</Project>
