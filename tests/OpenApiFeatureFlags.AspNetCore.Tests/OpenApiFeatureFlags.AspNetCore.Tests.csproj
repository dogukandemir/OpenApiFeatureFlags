<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>OpenApiFeatureFlags.AspNetCore.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <!-- net10.0 only, matching the adapter: the engine's 10.x line is the one on the 2.x document
         model. See the adapter project for why one assembly cannot serve both engines. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <!-- The engine's XML-comment support for minimal APIs is a source generator that emits
         interceptors, and .NET refuses to compile an interceptor unless its namespace is opted into.
         Without this, building any project that has XML doc comments on minimal API handlers fails
         with CS9137. Consumers need the same line; it is noted in docs/aspnetcore.md. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
    <NoWarn>$(NoWarn);CA1031;CA1034;CA1052;CA1062;CA1303;CA1305;CA1515;CA1707;CA1812;CA1819;CA1822;CA1859;CA1860;CA1861;CA2007;CA2201;CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- A real Kestrel-free host is the only public way to obtain a generated document: unlike
         Swashbuckle there is no ISwaggerProvider to resolve. This is the same host the engine serves
         from, so the tests exercise the transformers in their real position. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenApiFeatureFlags.AspNetCore\OpenApiFeatureFlags.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\OpenApiFeatureFlags\OpenApiFeatureFlags.csproj" />
    <ProjectReference Include="..\..\src\OpenApiFeatureFlags.Abstractions\OpenApiFeatureFlags.Abstractions.csproj" />
  </ItemGroup>

</Project>
