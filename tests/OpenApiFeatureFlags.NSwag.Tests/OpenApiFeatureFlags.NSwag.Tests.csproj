<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>OpenApiFeatureFlags.NSwag.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CA1031;CA1034;CA1052;CA1062;CA1303;CA1305;CA1515;CA1707;CA1812;CA1819;CA1822;CA1859;CA1860;CA1861;CA2007;CA2201;CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The full NSwag.AspNetCore, not the generation package: the tests obtain their document the
         way a consumer does, by requesting it from the middleware that serves it, which needs a real
         host and the serving middleware. -->
    <PackageReference Include="NSwag.AspNetCore" />
    <!-- TestHost ships one package per framework major, so a project that targets three frameworks
         needs three versions. The net10 pin is the central one; the older two are overridden here
         because each only serves one framework. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" VersionOverride="8.0.31" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" VersionOverride="9.0.20" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenApiFeatureFlags.NSwag\OpenApiFeatureFlags.NSwag.csproj" />
    <ProjectReference Include="..\..\src\OpenApiFeatureFlags\OpenApiFeatureFlags.csproj" />
    <ProjectReference Include="..\..\src\OpenApiFeatureFlags.Abstractions\OpenApiFeatureFlags.Abstractions.csproj" />
  </ItemGroup>

</Project>
